{
  "name": "apni-library-worker",
  "main": "src/index.js",
  
  "compatibility_date": "2026-09-27",

  "containers": [
    {
      "class_name": "ResultWorker",
      
      "image": "./Dockerfile",
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RESULT_WORKER", "class_name": "ResultWorker" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ResultWorker"] }
  ]
}
